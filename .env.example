# ==========================================
# AIQ Agentic AI Platform — Environment
# Copy to .env and fill in real values.
# Do NOT commit .env to git.
# ==========================================

# ---- PostgreSQL ----
POSTGRES_USER=aiq
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=aiq
POSTGRES_PORT=5432

# ---- Qdrant (vector DB) ----
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=changeme_qdrant_key

# ---- Redis (cache) ----
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# ---- Agent runtime ----
AGENT_PORT=8001
# Internal URL used by Gateway → Agent HttpClient (compose network)
AGENT_INTERNAL_BASE_URL=http://agent:8000
AGENT_TIMEOUT_SECONDS=300
# Provider selection: ollama | anthropic
LLM_PROVIDER=ollama
# Memory backend: in_memory | redis
MEMORY_BACKEND=redis
MEMORY_TTL_SECONDS=86400
MEMORY_MAX_MESSAGES=200
# Internal Redis URL used by Agent (compose network)
REDIS_INTERNAL_URL=redis://redis:6379/0

# ---- LLM providers ----
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048
# Local Qwen3 via Ollama (host:port)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:7b
OLLAMA_TIMEOUT_SECONDS=120

# ---- Gateway (ASP.NET Core) ----
GATEWAY_PORT=8080
JWT_ISSUER=aiq.local
JWT_AUDIENCE=aiq.client
JWT_SIGNING_KEY=changeme_long_random_signing_key_min_32_chars

# Shared secret that gates Gateway's /auth/external-link endpoint.
# The web tier sends it as X-Gateway-Secret header. MUST match
# GATEWAY_SHARED_SECRET in the web container.
EXTERNAL_AUTH_SHARED_SECRET=changeme_long_random_secret

# ---- Web (Next.js) ----
WEB_PORT=3030
# Internal URLs (compose network)
WEB_GATEWAY_BASE_URL=http://gateway:8080
WEB_AGENT_BASE_URL=http://agent:8000
# Matches EXTERNAL_AUTH_SHARED_SECRET above
GATEWAY_SHARED_SECRET=changeme_long_random_secret
# Comma-separated emails that auto-receive admin role on first Clerk sync
INITIAL_ADMIN_EMAIL=you@example.com

# Clerk auth (optional — when both blank, web falls back to email/password)
# Get keys from https://dashboard.clerk.com → Application → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Reverse proxy (Caddy) ----
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---- Observability ----
# OTLP/gRPC endpoint of your collector (Jaeger, SigNoz, Grafana Tempo, etc.)
# Leave empty to disable tracing export — SDK still configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
DEPLOY_ENV=development
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=changeme_grafana_admin_password
