{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=aiq;Username=aiq;Password=aiq;Pooling=true;Minimum Pool Size=4;Maximum Pool Size=100;Timeout=15;Command Timeout=30;Keepalive=30;Tcp Keepalive=true"
  },
  "Jwt": {
    "Issuer": "aiq.local",
    "Audience": "aiq.client",
    "SigningKey": "OVERRIDE_THIS_VIA_ENV_MIN_32_CHARS_______",
    "AccessTokenMinutes": 60
  },
  "FileUpload": {
    "MaxBytes": 52428800,
    "AllowedContentTypes": [ "application/pdf" ],
    "MagicBytes": {
      "application/pdf": "25-50-44-46-2D"
    },
    "MaxFilenameLength": 255
  },
  "Agent": {
    "BaseUrl": "http://agent:8000",
    "TimeoutSeconds": 300
  },
  "Jobs": {
    "UploadStagingDirectory": "/var/aiq/uploads",
    "WorkerCount": 4,
    "DashboardPath": "/jobs/dashboard"
  },
  "Observability": {
    "ServiceName": "aiq-gateway",
    "Environment": "production"
  },
  "ExternalAuth": {
    "SharedSecret": ""
  }
}
