{
  "schemaVersion": 39,
  "title": "AIQ Overview",
  "uid": "aiq-overview",
  "tags": ["aiq"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gateway requests / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(rate(http_requests_received_total{job=\"aiq-gateway\"}[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agent p95 latency (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"aiq-agent\"}[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Gateway 5xx rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total{job=\"aiq-gateway\",code=~\"5..\"}[5m])) by (code)",
          "refId": "A",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Recent gateway logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 10 },
      "targets": [
        { "expr": "{service=\"gateway\"}", "refId": "A" }
      ]
    }
  ]
}
